  "cues": [
    {
      "id": "1",
      "at": 0,
      "end": 3.576,
      "text": "先准备一份文案，再放入一段自己的录音。"
    },
    {
      "id": "2",
      "at": 3.576,
      "end": 7.494,
      "text": "克隆自己的声音，让每一段配音都保留熟悉的表达。"
    },
    {
      "id": "3",
      "at": 7.494,
      "end": 12.578,
      "text": "每段音频都有对应的时间戳，字幕和声音来自同一条时间轴。"
    },
    {
      "id": "4",
      "at": 12.578,
      "end": 17.289,
      "text": "接下来，让文字变成卡片，让卡片之间的关系动起来。"
    },
    {
      "id": "5",
      "at": 17.289,
      "end": 20.812,
      "text": "播放时，声音走到哪里，画面就推进到哪里。"
    },
    {
      "id": "6",
      "at": 20.812,
      "end": 25.068,
      "text": "最后得到可以自动播放的网页演示，也可以录制成视频。"
    }
  ]
